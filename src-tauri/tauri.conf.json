{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vFleet",
  "version": "1.3.0",
  "identifier": "io.github.zipkindev.vfleet",
  "build": {
    "frontendDist": "../desktop-shell"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "vFleet",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local-first VMware operator console",
    "longDescription": "A desktop console for VMware vCenter and standalone ESXi inventory, monitoring, and guarded operator workflows.",
    "copyright": "Copyright © 2026 vFleet contributors",
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "externalBin": ["binaries/vfleet-backend"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
