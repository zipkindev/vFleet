# Copy to .env and fill in, or sign in from the UI (Connect to vCenter).
# Never commit .env.

# auto = use vCenter when host+user+password are set, otherwise demo data
APP_MODE=auto

# Bind locally by default so power actions are not exposed on the LAN.
APP_HOST=127.0.0.1
APP_PORT=8080

# Optional. If set, every UI/API request must send header: X-UI-Token: <value>
UI_TOKEN=

# --- vCenter (required for APP_MODE=vcenter) ---
VCENTER_HOST=
VCENTER_USER=
VCENTER_PASSWORD=
VCENTER_PORT=443
# Accept lab/self-signed certificates
VCENTER_INSECURE=true

# Regex with one capture group used as the owner/username key.
# Default takes the leading token: mzipkin-win11-lab -> mzipkin
NAME_GROUP_PATTERN=^([A-Za-z][A-Za-z0-9]+)

# Custom-field names (vCenter) checked first for owner, comma-separated
OWNER_FIELD_NAMES=Owner,owner,User,user,CreatedBy,createdBy

# Idle / reclaim heuristics
IDLE_DAYS=14
CPU_IDLE_PCT=8
MEMORY_IDLE_PCT=20

# How far back to scan vCenter events for last console/power activity
EVENT_LOOKBACK_DAYS=30

# Local relay store (SQLite + staging uploads). Default: ./data
# DATA_DIR=/var/lib/vfleet
