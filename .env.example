# Copy to .env and fill in, or sign in from the UI (Connect to vSphere).
# Never commit .env.

# auto = use the configured vCenter/ESXi endpoint when credentials are set, otherwise demo
APP_MODE=auto

# Bind locally by default so power actions are not exposed on the LAN.
APP_HOST=127.0.0.1
APP_PORT=8080

# Optional. If set, every UI/API request must send header: X-UI-Token: <value>
UI_TOKEN=

# --- Portable encrypted credential vault ---
# UI-saved passwords are encrypted in DATA_DIR/credentials.enc.json. By
# default, a 256-bit key is generated in ~/.vfleet/credential.key. Services
# should point this at a separately mounted owner-only secret file.
# VFLEET_MASTER_KEY_FILE=/run/secrets/vfleet-credential-key
# Alternatively inject a base64-encoded 32-byte key directly into the process
# environment as VFLEET_MASTER_KEY; do not commit it or place it in this file.

# --- vSphere endpoint: vCenter or standalone ESXi ---
VCENTER_HOST=
VCENTER_USER=
VCENTER_PASSWORD=
VCENTER_PORT=443
# Accept lab/self-signed certificates
VCENTER_INSECURE=true

# Optional standalone ESXi disk-conversion fallback. Keep disabled unless the
# host license blocks write APIs. A known_hosts entry or pinned SHA256 host key
# is required. Execution is limited to internal vmkfstools clone commands.
ESXI_SSH_ENABLED=false
ESXI_SSH_USER=
ESXI_SSH_PASSWORD=
ESXI_SSH_PORT=22
ESXI_SSH_KEY_PATH=
ESXI_SSH_HOST_KEY_SHA256=
ESXI_SSH_USE_LOGIN_PASSWORD=false

# Regex with one capture group used as the owner/username key.
# Default takes the leading token: mzipkin-win11-lab -> mzipkin
NAME_GROUP_PATTERN=^([A-Za-z][A-Za-z0-9]+)

# Custom-field names (vCenter) checked first for owner, comma-separated
OWNER_FIELD_NAMES=Owner,owner,User,user,CreatedBy,createdBy

# Idle / reclaim heuristics
IDLE_DAYS=14
CPU_IDLE_PCT=8
MEMORY_IDLE_PCT=20

# How far back to scan vCenter events for last console/power activity
EVENT_LOOKBACK_DAYS=30

# Local relay store (SQLite + staging uploads). Default: ./data
# DATA_DIR=/var/lib/vfleet
